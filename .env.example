# Copy this file to `.env.local` and fill in your real keys.
# `.env.local` and `.env` are git-ignored: never commit real credentials.
#
# Format: CRYPTONITE__CREDENTIALS__<EXCHANGE>__<FIELD>
# An exchange with no key set is skipped for trading.
# Use keys with the minimum permissions the bot needs, and disable withdrawals.

# Nobitex - API key (recommended): API_KEY is the public key (the "key" field),
# API_SECRET is the privateKey, which Nobitex shows only once when the key is
# created. Give the key READ (and TRADE for orders) permissions plus an IP whitelist.
# Alternatively, set only API_KEY to a login token (full account access).
CRYPTONITE__CREDENTIALS__NOBITEX__API_KEY=
CRYPTONITE__CREDENTIALS__NOBITEX__API_SECRET=

# Wallex
CRYPTONITE__CREDENTIALS__WALLEX__API_KEY=
# CRYPTONITE__CREDENTIALS__WALLEX__API_SECRET=

# Bitpin
CRYPTONITE__CREDENTIALS__BITPIN__API_KEY=
CRYPTONITE__CREDENTIALS__BITPIN__API_SECRET=
